# CoinGecko API (free tier — no key needed, but add one for higher rate limits)
NEXT_PUBLIC_COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Optional: CoinGecko Pro API key
COINGECKO_API_KEY=

# App settings
NEXT_PUBLIC_REFRESH_INTERVAL_MS=60000
NEXT_PUBLIC_DEFAULT_CURRENCY=usd
NEXT_PUBLIC_DEFAULT_COIN_LIMIT=50
